{
  "name": "@haruhimemoe/ordr",
  "version": "0.1.0",
  "description": "Client for o!rdr, the online osu! replay renderer: queue renders from .osr files or replay URLs, wait for the video, read renders and skins, and render every player's replay of one match map. Server-side; zod is the only peer.",
  "keywords": [
    "osu",
    "osu!",
    "ordr",
    "o!rdr",
    "danser",
    "replay",
    "render",
    "tournament"
  ],
  "homepage": "https://github.com/haruhimemoe/ordr#readme",
  "bugs": "https://github.com/haruhimemoe/ordr/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haruhimemoe/ordr.git"
  },
  "license": "MIT",
  "author": "David (https://dvh.sh)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:dist": "bun run build && node scripts/smoke.mjs",
    "prepublishOnly": "bun run check && bun run typecheck && bun run test && bun run test:dist"
  },
  "peerDependencies": {
    "zod": "^4.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
